# Database Configuration
# Options: sqlite, mongodb
DATABASE_PROVIDER=sqlite
DATABASE_PATH=properties.db

# MongoDB Atlas (if DATABASE_PROVIDER=mongodb)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ulpin

# Firebase Admin Configuration (Required for token validation in production mode)
# Path to service account JSON certificate file. If missing, runs in development (bypass) mode.
FIREBASE_CREDENTIALS_JSON=path/to/firebase-adminsdk.json

# Server Configuration
PORT=8000
HOST=127.0.0.1

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
